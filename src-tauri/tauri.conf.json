{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitoza",
  "version": "0.0.0-dev",
  "identifier": "com.gitoza",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "decorations": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 14, "y": 20 },
        "width": 1280,
        "height": 800,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.gitoza/assets_cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Weiwen Weng (275QDAP5G2)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMjRGM0M4QTJGQUNFNEEKUldSS3p2cWl5UE1rSGlaMytmUmt1bkVnbkNyNHFKdms4ajBTTnRNN1plSFloNHFuSnhaMVhoRy8K",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
